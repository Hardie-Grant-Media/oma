{
  "name": "oma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:functions": "deno check --config supabase/functions/deno.json supabase/functions/api/index.ts supabase/functions/worker/index.ts supabase/functions/report-reader/index.ts",
    "test:db": "supabase test db",
    "test:functions": "deno test --allow-env --config supabase/functions/deno.json tests/functions",
    "format": "prettier --write src tests supabase/functions *.json *.ts *.md",
    "dev:viewer": "vite --config vite.viewer.config.ts",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "test:password": "playwright test --config playwright.password.config.ts",
    "test:sharing": "playwright test --config playwright.sharing.config.ts",
    "build:hosted": "npm run build && npm run build:viewer"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-router": "1.170.33",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "domutils": "3.2.2",
    "htmlparser2": "10.0.0",
    "lucide-react": "1.42.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.36",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "deno": "2.2.12",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
